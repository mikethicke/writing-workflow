# Copy this file to ~/.config/substack-publish/.env and fill it in.
#
# That location is the default on purpose: COOKIES_STRING below is a live
# session credential, and this repository is public. Keep it out of any
# working tree. To use a different path, set SUBSTACK_ENV_FILE to it.
#
#   mkdir -p ~/.config/substack-publish
#   cp .env.example ~/.config/substack-publish/.env
#   chmod 600 ~/.config/substack-publish/.env

# Your publication's base URL, no trailing slash.
PUBLICATION_URL=https://yourname.substack.com

# The full Cookie header from a signed-in Substack session.
#
# python-substack talks to Substack's private API, which has no tokens or API
# keys -- it authenticates as your browser. To get this value:
#
#   1. Sign in to Substack in your browser.
#   2. Open devtools -> Network, and reload any page on your publication.
#   3. Click the document request, find Request Headers -> Cookie.
#   4. Copy the entire value (it is long) and paste it on one line below.
#
# This grants full access to your Substack account. Treat it like a password:
# never commit it, never paste it into an issue. It expires when the session
# does, so expect to repeat this every so often -- a sudden 401 from the
# publish script usually means the cookie went stale, not that anything broke.
COOKIES_STRING=paste-the-entire-cookie-header-here
